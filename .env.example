# gRPC-Web server connection settings
#
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#
# Values can also be overridden at build time via --dart-define:
#   flutter run --dart-define=GRPC_HOST=10.0.0.5

# Server hostname or IP address
GRPC_HOST=localhost

# gRPC-Web port (the Go backend starts gRPC-Web on :8080 by default)
GRPC_PORT=8080

# Enable TLS (set to true for production with HTTPS)
GRPC_TLS=false
